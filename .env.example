# Local Ollama endpoint. Keep this server-side; do not expose secrets in client code.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional cloud provider can be added later via a server-only API key.

# Supabase production auth and user-owned data. The publishable/anon key is safe
# for browser use only because the supplied schema enforces row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
