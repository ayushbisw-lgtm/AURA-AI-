# Local Ollama endpoint. Keep this server-side; do not expose secrets in client code.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional cloud provider can be added later via a server-only API key.

# Supabase auth and user-owned data. Changing NEXT_PUBLIC_* variables requires
# restarting the local dev server or rebuilding and redeploying the app.
NEXT_PUBLIC_SUPABASE_URL=https://vgaxeusmmzyeziccawbs.supabase.co
# Use the Supabase publishable key. The legacy anon key is an optional fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Exam Planner scheduled email reminders (server-only; never prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=AURA AI <reminders@example.com>
CRON_SECRET=

# Microsoft Outlook college notice sync (server-only)
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TOKEN_ENCRYPTION_KEY=
